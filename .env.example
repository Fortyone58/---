# Template only. This computer already has a private MySQL .env; do not overwrite it.
# SQLite below is a fallback for fresh setup before the one-time managed migration.
DATABASE_URL=sqlite:///../data/campus_demo.db
APP_ENV=demo
JWT_SECRET=replace-with-a-random-local-secret
TOKEN_HOURS=12
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=replace-with-a-local-password
# DATABASE_URL=mysql+pymysql://campus_demo:your-password@127.0.0.1:3306/campus_workstudy?charset=utf8mb4
# Managed local MySQL fields are generated by scripts/migrate_to_mysql.py:
# QINGHE_MYSQL_MANAGED, MYSQL_RUNTIME_DIR, MYSQLD_PATH, MYSQL_MANAGER_PASSWORD.
# Do not set managed=1 for an existing/external MySQL service.
# v0.3: administrators can save these via AI settings in the local app.
# Never put real keys in this example file or send them in chat.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Generated only after a successful local connection test.
LLM_VERIFIED_FINGERPRINT=
